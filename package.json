    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/react-router": "^1.3.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vercel": "63.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
