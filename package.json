    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@vercel/functions": "3.9.9",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.2.2",
    "lucide-react": "^1.55.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
