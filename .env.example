# Copy to .env for local dev. Values match docker-compose.yml (local only).

# App runtime: tenant pool, logs in as app_tenant (prod: Neon pooled URL).
DATABASE_URL_TENANT=postgres://app_tenant:app_tenant_local@localhost:5432/client_dashboard
# App runtime: system pool, logs in as app_system (prod: Neon pooled URL).
DATABASE_URL_SYSTEM=postgres://app_system:app_system_local@localhost:5432/client_dashboard

# Migrate command: runs migrations as neondb_owner (prod: Neon direct URL).
DATABASE_URL_OWNER=postgres://neondb_owner:neondb_owner_local@localhost:5432/client_dashboard
# Migrate command: password it sets for app_tenant; must match DATABASE_URL_TENANT.
APP_TENANT_PASSWORD=app_tenant_local
# Migrate command: password it sets for app_system; must match DATABASE_URL_SYSTEM.
APP_SYSTEM_PASSWORD=app_system_local

# App runtime: time limit in ms for every query on both pools (default 10000).
# Migrations aren't bound by it.
DB_QUERY_TIMEOUT_MS=10000

# Build: VERCEL is set to 1 by Vercel's build and switches on the Vercel preset.
# Never set it locally: the preset's output doesn't run under react-router-serve.
# VERCEL=

# App runtime: Better Auth signing secret, min 32 chars. Local throwaway value;
# prod: `openssl rand -base64 32`. Rotating it signs everyone out.
BETTER_AUTH_SECRET=local-only-better-auth-secret-change-me-0123456789
# App runtime: public base URL, an origin with no trailing slash; https except
# on localhost. Drives cookies, trusted origins, the passkey rpID and the links
# in emails.
BETTER_AUTH_URL=http://localhost:5173
# App runtime: the Admin's email (compared case-insensitively). Set your own:
# magic links are only sent to this address.
ADMIN_EMAIL=admin@example.com

# App runtime: SMTP server. Locally Mailpit (docker compose); read the mail at
# http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
# App runtime: SMTP auth, both or neither. Unset for Mailpit. When
# SMTP_PASSWORD is set, SMTP_PORT must be 465 (implicit TLS).
# SMTP_USER=
# SMTP_PASSWORD=
# App runtime: sender address. The display name is always "Neves Labs".
MAIL_FROM=portal@localhost.test

# App runtime: Google OAuth client for Client User sign-in, both or neither.
# Unset, Google sign-in is off and its button is hidden. Redirect URI:
# ${BETTER_AUTH_URL}/api/auth/callback/google. Required on prod (the secret is
# a Vercel sensitive var).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# App runtime: the read-only GitHub App that reads the org's Projects v2
# boards, all five or none. Unset, board sync is off. Required on prod (the
# private key and webhook secret are Vercel sensitive vars).
# App runtime: the App's id (App settings page).
# GITHUB_APP_ID=
# App runtime: the App's private key PEM, multiline as-is (literal \n escapes
# are also accepted).
# GITHUB_APP_PRIVATE_KEY=
# App runtime: the App's installation id on the org (a positive integer).
# GITHUB_APP_INSTALLATION_ID=
# App runtime: the webhook secret the App signs its deliveries with.
# GITHUB_WEBHOOK_SECRET=
# App runtime: the org login whose boards are read, e.g. Neves-Labs-Inc.
# GITHUB_ORG=

# App runtime: the bearer Vercel Cron sends to /jobs/reconcile, min 32 chars.
# Unset, the reconcile job answers 503. Required on prod (a Vercel sensitive
# var): `openssl rand -base64 32`.
# CRON_SECRET=

# Local only, read by `pnpm dev:webhooks` (never by the app): the dev GitHub
# App's smee.io channel (its webhook URL), forwarded to
# http://localhost:5173/webhooks/github.
# SMEE_URL=
