# Copy to .env for local dev. Values match docker-compose.yml (local only).

# App runtime: tenant pool, logs in as app_tenant (prod: Neon pooled URL).
DATABASE_URL_TENANT=postgres://app_tenant:app_tenant_local@localhost:5432/client_dashboard
# App runtime: system pool, logs in as app_system (prod: Neon pooled URL).
DATABASE_URL_SYSTEM=postgres://app_system:app_system_local@localhost:5432/client_dashboard

# Migrate command: runs migrations as neondb_owner (prod: Neon direct URL).
DATABASE_URL_OWNER=postgres://neondb_owner:neondb_owner_local@localhost:5432/client_dashboard
# Migrate command: password it sets for app_tenant; must match DATABASE_URL_TENANT.
APP_TENANT_PASSWORD=app_tenant_local
# Migrate command: password it sets for app_system; must match DATABASE_URL_SYSTEM.
APP_SYSTEM_PASSWORD=app_system_local

# App runtime: time limit in ms for every query on both pools (default 10000).
# Migrations aren't bound by it.
DB_QUERY_TIMEOUT_MS=10000

# Build: VERCEL is set to 1 by Vercel's build and switches on the Vercel preset.
# Never set it locally: the preset's output doesn't run under react-router-serve.
# VERCEL=
