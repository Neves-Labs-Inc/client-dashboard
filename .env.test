# Test env for `pnpm test`, loaded by the Vitest global setup. Vars already
# set (e.g. by CI) win. Local Docker credentials only. Roles are cluster-wide,
# so the passwords must equal the ones in .env or each migrate resets the other.

# Tenant pool, as app_tenant.
DATABASE_URL_TENANT=postgres://app_tenant:app_tenant_local@localhost:5432/client_dashboard_test
# System pool, as app_system.
DATABASE_URL_SYSTEM=postgres://app_system:app_system_local@localhost:5432/client_dashboard_test

# Migrate command, as neondb_owner.
DATABASE_URL_OWNER=postgres://neondb_owner:neondb_owner_local@localhost:5432/client_dashboard_test
# Passwords the migrate command sets; must match the URLs above.
APP_TENANT_PASSWORD=app_tenant_local
APP_SYSTEM_PASSWORD=app_system_local
